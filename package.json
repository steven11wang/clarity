  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.92.0"
  }
}
