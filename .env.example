# Keep this value on the server. Never expose it through a VITE_* variable.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Flagship vision model for the highest extraction reliability and current safeguards.
OPENAI_VISION_MODEL=gpt-5.6-sol

# Safe to expose in the browser. Row-level security protects each user's data.
# Find both values in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_publishable_anon_key

# Merriam-Webster (dictionaryapi.com). Build time only - tools/build-dictionary.mjs
# bakes definitions into public/data/dictionary.json, so the browser never holds
# a key. Register one key against "Learner's" and one against "Collegiate".
MERRIAM_WEBSTER_LEARNERS_KEY=replace_with_your_learners_key
MERRIAM_WEBSTER_COLLEGIATE_KEY=replace_with_your_collegiate_key
